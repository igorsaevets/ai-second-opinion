{
  "description": "PostToolUse on Edit|Write: the duplicate-JSON-key guard on the file just written (a duplicate key in channels.json silently overwrites the first). SessionStart: update_check.py --hook, which says when a newer release exists (shell form, python3 || python || py -3).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/check_json_dup_keys_hook.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/model-orchestration/update_check.py\" --hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/model-orchestration/update_check.py\" --hook || py -3 \"${CLAUDE_PLUGIN_ROOT}/skills/model-orchestration/update_check.py\" --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
